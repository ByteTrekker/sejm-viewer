<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         displayDetailsOnTestsThatTriggerWarnings="true">
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>

    <!-- Próg pokrycia pilnuje warstwy czystej: domeny i parsowania argumentów.
         Reszta (klient HTTP, import, budowanie raportu) jest pokryta testem
         dymnym end-to-end, a nie testami jednostkowymi. -->
    <source>
        <include>
            <directory>src/Domain</directory>
            <directory>src/Console</directory>
        </include>
    </source>
</phpunit>
